{
  "name": "aporiax-desktop",
  "productName": "AporiaX",
  "description": "A local desktop coding agent with reviewable tools and mandatory self-check.",
  "author": "SeaLandX",
  "license": "MIT",
  "homepage": "https://github.com/CaptainLand/AporiaX#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaptainLand/AporiaX.git"
  },
  "bugs": {
    "url": "https://github.com/CaptainLand/AporiaX/issues"
  },
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "main": "electron/main-v2.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron . --dev",
    "build": "vite build",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "preview": "vite preview",
    "start": "electron .",
    "browser:install": "playwright-core install chromium",
    "test:runtime": "node tests/runtime-smoke.mjs",
    "test:p0": "node tests/p0-model-smoke.mjs",
    "test:cache": "node tests/deepseek-cache-smoke.mjs",
    "test:architecture": "node tests/harness-architecture-smoke.mjs",
    "test:collaboration": "node tests/harness-collaboration-smoke.mjs",
    "test:desktop-background": "node tests/desktop-background-smoke.mjs",
    "test:vision": "node tests/vision-proxy-smoke.mjs",
    "test:runtime-ui": "node tests/runtime-ui-smoke.mjs",
    "test:process-ui": "node tests/agent-process-mentions-smoke.mjs",
    "test:task-store": "node tests/task-store-smoke.mjs",
    "test:renderer-architecture": "node tests/native-renderer-architecture-smoke.mjs",
    "test:renderer-modules": "node tests/renderer-modules-smoke.mjs",
    "test:harness-events-ui": "node tests/harness-event-hook-smoke.mjs",
    "test:provider-stream": "node tests/provider-stream-smoke.mjs",
    "test:skills": "node tests/skill-system-smoke.mjs",
    "test:browser": "node tests/browser-runtime-smoke.mjs",
    "test:mcp": "node tests/mcp-runtime-smoke.mjs",
    "test:execution-policy": "node tests/execution-policy-smoke.mjs",
    "test:execution-wiring": "node tests/execution-mode-wiring-smoke.mjs",
    "test:lsp": "node tests/lsp-runtime-smoke.mjs",
    "test:tool-permissions": "node tests/tool-permissions-smoke.mjs",
    "test:harness-v2": "node tests/harness-v2-smoke.mjs && node tests/harness-collaboration-smoke.mjs && node tests/harness-v2-orchestration-smoke.mjs",
    "test:streaming-performance": "node tests/streaming-performance-smoke.mjs",
    "test:tool-dispatcher": "node tests/tool-dispatcher-smoke.mjs",
    "test:self-check-evidence": "node tests/self-check-evidence-smoke.mjs",
    "test:subagent-model": "node tests/subagent-model-smoke.mjs",
    "test:subagent-loop": "node tests/subagent-loop-smoke.mjs",
    "test:native-tool-executor": "node tests/native-tool-executor-smoke.mjs",
    "test:workspace-runtime": "node tests/workspace-runtime-smoke.mjs",
    "test:conversation-runtime": "node tests/conversation-runtime-smoke.mjs",
    "test:self-check-coordinator": "node tests/self-check-coordinator-smoke.mjs",
    "test:native-tool-catalog": "node tests/native-tool-catalog-smoke.mjs",
    "test:capabilities": "node tests/capability-registry-smoke.mjs",
    "test:mcp-capabilities": "node tests/mcp-capabilities-smoke.mjs",
    "test:extensions": "node tests/extensions-center-smoke.mjs",
    "test:extension-library": "node tests/extension-library-smoke.mjs",
    "test:sandbox-watchdog": "node tests/sandbox-watchdog-smoke.mjs",
    "test:witness-watchdog": "node tests/witness-watchdog-smoke.mjs",
    "test:understanding-automation": "node tests/understanding-automation-smoke.mjs",
    "test:capability-observability": "node tests/capability-observability-smoke.mjs",
    "test:harness-event-reducer": "node tests/harness-event-reducer-smoke.mjs",
    "test:turn-coordinator": "node tests/turn-coordinator-smoke.mjs",
    "test:extension-policy": "node tests/extension-policy-smoke.mjs",
    "test:v06-architecture": "node tests/v06-architecture-freeze-smoke.mjs",
    "test:v061-capabilities": "node tests/v061-capabilities-smoke.mjs",
    "test:account-ui": "node tests/local-account-ui-smoke.mjs",
    "test:welcome-performance": "node tests/welcome-particle-performance-smoke.mjs",
    "test:run-retry": "node tests/run-retry-core-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vscode/ripgrep": "^1.18.0",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "playwright-core": "^1.62.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript-language-server": "^5.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.aporiax.desktop",
    "productName": "AporiaX",
    "copyright": "Copyright © 2026 SeaLandX",
    "asar": true,
    "asarUnpack": [
      "node_modules/@vscode/ripgrep-*/**/*",
      "node_modules/typescript-language-server/**/*",
      "node_modules/typescript/**/*"
    ],
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "AporiaX-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AporiaX"
    },
    "portable": {
      "artifactName": "AporiaX-Portable-${version}-${arch}.${ext}"
    }
  }
}
