{
  "name": "aporiax-desktop",
  "productName": "AporiaX",
  "description": "A local desktop coding agent with reviewable tools and honest, agent-led verification.",
  "author": "SeaLandX",
  "license": "MIT",
  "homepage": "https://github.com/CaptainLand/AporiaX#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaptainLand/AporiaX.git"
  },
  "bugs": {
    "url": "https://github.com/CaptainLand/AporiaX/issues"
  },
  "private": true,
  "version": "0.9.8",
  "type": "module",
  "main": "electron/main-v2.js",
  "scripts": {
    "test:0.9.7": "node --experimental-sqlite tests/release097-git.mjs && node --experimental-sqlite tests/release097-builders.mjs && node --experimental-sqlite tests/release097-ocr.mjs && node --experimental-sqlite tests/release097-browser.mjs && electron tests/release097-electron.cjs && electron tests/release097-asar.cjs",
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron . --dev",
    "build": "vite build",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "preview": "vite preview",
    "start": "electron .",
    "browser:install": "playwright-core install chromium",
    "test:runtime": "node --experimental-sqlite tests/runtime-smoke.mjs",
    "test:priority-one": "node --experimental-sqlite tests/priority-one-runtime-smoke.mjs",
    "test:runtime-efficiency": "node --experimental-sqlite tests/runtime-efficiency-smoke.mjs && node --experimental-sqlite tests/runtime-concurrency-integration.mjs && node --experimental-sqlite tests/runtime-background-integration.mjs",
    "test:delivery-auto": "node --experimental-sqlite tests/full-auto-delivery-smoke.mjs && node --experimental-sqlite tests/delivery-runtime-integration.mjs && node --experimental-sqlite tests/delivery-guidance-smoke.mjs && node --experimental-sqlite tests/approval-settings-browser.mjs && electron tests/electron-sandbox-asar-smoke.cjs",
    "test:links-steering": "node --experimental-sqlite tests/link-integrity.mjs && node --experimental-sqlite tests/links-steering-smoke.mjs && node --experimental-sqlite tests/steering-runtime-integration.mjs && node --experimental-sqlite tests/links-steering-browser.mjs && electron tests/desktop-links-electron.cjs",
    "test:run-store-sqlite": "node --experimental-sqlite tests/run-store-sqlite-smoke.mjs",
    "test:task-runtime-rpc": "node --experimental-sqlite tests/task-runtime-rpc-smoke.mjs",
    "test:critical-reliability": "node --experimental-sqlite tests/approval-response-regression.mjs && node --experimental-sqlite tests/builder-merge-regression.mjs && node --experimental-sqlite tests/builder-merge-crash.mjs",
    "test:context-reliability": "node --experimental-sqlite tests/context-continuation-regression.mjs && node --experimental-sqlite tests/mcp-deferred-catalog.mjs && node --experimental-sqlite tests/understanding-lock-recovery.mjs",
    "test:reliability-batch3": "node --experimental-sqlite tests/reliability-storage.mjs && node --experimental-sqlite tests/remote-command-inbox.mjs && node --experimental-sqlite tests/project-script-trust.mjs && node --experimental-sqlite tests/human-constraints.mjs && node --experimental-sqlite tests/release-source.mjs",
    "test:agent-runtime-broker": "node --experimental-sqlite tests/agent-runtime-broker-smoke.mjs",
    "test:p0": "node --experimental-sqlite tests/p0-model-smoke.mjs",
    "test:cache": "node --experimental-sqlite tests/deepseek-cache-smoke.mjs",
    "test:architecture": "node --experimental-sqlite tests/harness-architecture-smoke.mjs",
    "test:collaboration": "node --experimental-sqlite tests/harness-collaboration-smoke.mjs",
    "test:desktop-background": "node --experimental-sqlite tests/desktop-background-smoke.mjs",
    "test:vision": "node --experimental-sqlite tests/vision-proxy-smoke.mjs",
    "test:vision-recovery": "node --experimental-sqlite tests/recovery-approval-regression.mjs && node --experimental-sqlite tests/vision-capability-regression.mjs && node --experimental-sqlite tests/vision-proxy-smoke.mjs && node --experimental-sqlite tests/aporia-cloud-vision-smoke.mjs && node --experimental-sqlite tests/model-vision-browser.mjs && electron tests/vision-request-electron.cjs",
    "test:runtime-ui": "node --experimental-sqlite tests/runtime-ui-smoke.mjs",
    "test:process-ui": "node --experimental-sqlite tests/agent-process-mentions-smoke.mjs",
    "test:task-store": "node --experimental-sqlite tests/task-store-smoke.mjs && node --experimental-sqlite tests/task-history-store-smoke.mjs",
    "test:renderer-architecture": "node --experimental-sqlite tests/native-renderer-architecture-smoke.mjs",
    "test:renderer-modules": "node --experimental-sqlite tests/renderer-modules-smoke.mjs && node --experimental-sqlite tests/composer-attachment-drag-smoke.mjs",
    "test:harness-events-ui": "node --experimental-sqlite tests/harness-event-hook-smoke.mjs",
    "test:provider-stream": "node --experimental-sqlite tests/provider-stream-smoke.mjs",
    "test:side-chat": "node --experimental-sqlite tests/side-chat-smoke.mjs && node --experimental-sqlite tests/side-chat-browser.mjs",
    "test:workbench-documents-git": "node --experimental-sqlite tests/workbench-git-smoke.mjs && node --experimental-sqlite tests/workbench-documents-git-browser.mjs",
    "test:workbench-git-setup": "node --experimental-sqlite tests/workbench-git-setup-smoke.mjs && node --experimental-sqlite tests/workbench-git-setup-browser.mjs",
    "test:workbench-git-setup-electron": "electron tests/workbench-git-setup-electron.cjs",
    "test:terminal-v2": "node --experimental-sqlite tests/terminal-buffer-smoke.mjs && node --experimental-sqlite tests/terminal-v2-browser.mjs && electron tests/terminal-v2-electron.cjs",
    "test:terminal-interaction": "node --experimental-sqlite tests/terminal-native-ui.mjs && electron tests/desktop-icon-smoke.cjs",
    "test:workbench-document-electron": "electron tests/workbench-document-electron.cjs",
    "test:cloud-model": "node --experimental-sqlite tests/aporia-cloud-model-runtime-smoke.mjs",
    "test:skills": "node --experimental-sqlite tests/skill-system-smoke.mjs",
    "test:browser": "node --experimental-sqlite tests/browser-runtime-smoke.mjs",
    "test:mcp": "node --experimental-sqlite tests/mcp-runtime-smoke.mjs",
    "test:execution-policy": "node --experimental-sqlite tests/execution-policy-smoke.mjs",
    "test:execution-wiring": "node --experimental-sqlite tests/execution-mode-wiring-smoke.mjs",
    "test:lsp": "node --experimental-sqlite tests/lsp-runtime-smoke.mjs",
    "test:tool-permissions": "node --experimental-sqlite tests/tool-permissions-smoke.mjs",
    "test:harness-v2": "node --experimental-sqlite tests/harness-v2-smoke.mjs && node --experimental-sqlite tests/harness-collaboration-smoke.mjs && node --experimental-sqlite tests/harness-v2-orchestration-smoke.mjs",
    "test:streaming-performance": "node --experimental-sqlite tests/streaming-performance-smoke.mjs",
    "test:tool-dispatcher": "node --experimental-sqlite tests/tool-dispatcher-smoke.mjs",
    "test:self-check-evidence": "node --experimental-sqlite tests/self-check-evidence-smoke.mjs",
    "test:subagent-model": "node --experimental-sqlite tests/subagent-model-smoke.mjs",
    "test:subagent-loop": "node --experimental-sqlite tests/subagent-loop-smoke.mjs",
    "test:native-tool-executor": "node --experimental-sqlite tests/native-tool-executor-smoke.mjs",
    "test:workspace-runtime": "node --experimental-sqlite tests/workspace-runtime-smoke.mjs",
    "test:conversation-runtime": "node --experimental-sqlite tests/conversation-runtime-smoke.mjs",
    "test:self-check-coordinator": "node --experimental-sqlite tests/self-check-coordinator-smoke.mjs",
    "test:native-tool-catalog": "node --experimental-sqlite tests/native-tool-catalog-smoke.mjs",
    "test:capabilities": "node --experimental-sqlite tests/capability-registry-smoke.mjs",
    "test:mcp-capabilities": "node --experimental-sqlite tests/mcp-capabilities-smoke.mjs",
    "test:extensions": "node --experimental-sqlite tests/extensions-center-smoke.mjs",
    "test:extension-library": "node --experimental-sqlite tests/extension-library-smoke.mjs && node --experimental-sqlite tests/extension-ecosystem-regression.mjs && node --experimental-sqlite tests/extension-discovery.mjs",
    "test:extension-library-browser": "node --experimental-sqlite tests/extension-library-browser.mjs && node --experimental-sqlite tests/extension-discovery-browser.mjs",
    "test:sandbox-watchdog": "node --experimental-sqlite tests/sandbox-watchdog-smoke.mjs",
    "test:sandbox-recovery": "node --experimental-sqlite tests/sandbox-priority-regression.mjs && node --experimental-sqlite tests/sandbox-harness-integration.mjs && node --experimental-sqlite tests/sandbox-audit-probes.mjs",
    "test:witness-watchdog": "node --experimental-sqlite tests/witness-watchdog-smoke.mjs",
    "test:understanding-automation": "node --experimental-sqlite tests/understanding-automation-smoke.mjs",
    "test:capability-observability": "node --experimental-sqlite tests/capability-observability-smoke.mjs",
    "test:harness-event-reducer": "node --experimental-sqlite tests/harness-event-reducer-smoke.mjs",
    "test:turn-coordinator": "node --experimental-sqlite tests/turn-coordinator-smoke.mjs",
    "test:extension-policy": "node --experimental-sqlite tests/extension-policy-smoke.mjs",
    "test:v06-architecture": "node --experimental-sqlite tests/v06-architecture-freeze-smoke.mjs",
    "test:v061-capabilities": "node --experimental-sqlite tests/v061-capabilities-smoke.mjs",
    "test:account-ui": "node --experimental-sqlite tests/local-account-ui-smoke.mjs",
    "test:app-update": "node --experimental-sqlite tests/app-update-smoke.mjs",
    "test:welcome-performance": "node --experimental-sqlite tests/welcome-particle-performance-smoke.mjs && node --experimental-sqlite tests/gpu-guard-smoke.mjs",
    "test:welcome-gem": "node --experimental-sqlite tests/welcome-gem-browser.mjs",
    "test:run-retry": "node --experimental-sqlite tests/run-retry-core-smoke.mjs",
    "test:run-reliability": "node --experimental-sqlite tests/tool-message-contract.mjs && node --experimental-sqlite tests/runtime-tool-receipts.mjs && node --experimental-sqlite tests/run-retry-core-smoke.mjs && node --experimental-sqlite tests/task-outcome-view.mjs && node --experimental-sqlite tests/task-outcomes-browser.mjs",
    "test:github-workflow": "node --experimental-sqlite tests/github-workflow-smoke.mjs",
    "test:lsp-installer": "node --experimental-sqlite tests/lsp-installer-smoke.mjs",
    "test:workbench-state": "node --experimental-sqlite tests/workbench-state-smoke.mjs && node --experimental-sqlite tests/workbench-present-smoke.mjs && node --experimental-sqlite tests/composer-workbench-browser.mjs",
    "test:audit": "node --experimental-sqlite tests/audit-reliability.mjs",
    "test:audit-suite": "node --experimental-sqlite scripts/run-audit-checks.mjs",
    "test:harness-loop": "node --experimental-sqlite tests/harness-loop-unit.mjs && node --experimental-sqlite tests/harness-loop-provider.mjs && node --experimental-sqlite tests/harness-loop-integration.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/canvas": "0.1.100",
    "@paper-design/shaders": "^0.0.80",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "docx-preview": "0.4.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "highlight.js": "11.12.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "node-pty": "1.1.0",
    "pdfjs-dist": "^4.10.38",
    "playwright-core": "^1.62.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tesseract.js": "7.0.0",
    "typescript-language-server": "^5.3.0",
    "unified": "^11.0.5",
    "yaml": "2.9.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.aporiax.desktop",
    "productName": "AporiaX",
    "copyright": "Copyright © 2026 SeaLandX",
    "asar": true,
    "asarUnpack": [
      "electron/ocr/**/*",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*",
      "node_modules/@napi-rs/**/*",
      "node_modules/pdfjs-dist/**/*",
      "node_modules/wasm-feature-detect/**/*",
      "node_modules/bmp-js/**/*",
      "node_modules/is-url/**/*",
      "node_modules/regenerator-runtime/**/*",
      "node_modules/idb-keyval/**/*",
      "node_modules/node-fetch/**/*",
      "node_modules/zlibjs/**/*",
      "node_modules/@vscode/ripgrep-*/**/*",
      "node_modules/typescript-language-server/**/*",
      "node_modules/typescript/**/*"
    ],
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "build/icon-dark.ico",
      "package.json"
    ],
    "win": {
      "icon": "icon-dark.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "AporiaX-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AporiaX"
    },
    "portable": {
      "artifactName": "AporiaX-Portable-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "CaptainLand",
      "repo": "AporiaX"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
